  <!-- SleepDisturbed -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThoughtDef[defName = "SleepDisturbed"]/durationDays</xpath>
	<value>
	  <durationDays>0.0001</durationDays>
	</value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThoughtDef[defName = "SleepDisturbed"]/stackLimit</xpath>
	<value>
	    <stackLimit>0</stackLimit>
	</value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThoughtDef[defName = "SleepDisturbed"]/showBubble</xpath>
	<value>
	  <showBubble>false</showBubble>
	</value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThoughtDef[defName = "SleepDisturbed"]/stackedEffectMultiplier</xpath>
	<value>
	  <stackedEffectMultiplier>0</stackedEffectMultiplier>
	</value>
  </Operation>  

  <!-- RocketPatch -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="DestroyWeapon"]/defaultIngredientFilter/disallowedThingDefs</xpath>
	<value>
	  <disallowedThingDefs>
        <li>OrbitalTargeterPowerBeam</li>
        <li>OrbitalTargeterBombardment</li>
        <li>TornadoGenerator</li>
	  </disallowedThingDefs>
	</value>
  </Operation>
  
  <!-- Natural Rock wall statBases -->
	<Operation Class="PatchOperationReplace">
		<xpath>*/ThingDef[defName = "Sandstone" or defName = "Granite" or defName = "Limestone" or defName = "Slate" or defName = "Marble"]/statBases</xpath>
		<value>
			<statBases>
				<MaxHitPoints>900</MaxHitPoints> <!-- normal varies, granite 900-->
				<Beauty>-1</Beauty> <!-- normal -2, marble -1-->
			</statBases>
		</value>
	</Operation>

<!-- Smoothed Natural Rock wall statBases -->	
	<Operation Class="PatchOperationReplace">
		<xpath>*/ThingDef[defName = "SmoothedSandstone" or defName = "SmoothedGranite" or defName = "SmoothedLimestone" or defName = "SmoothedSlate" or defName = "SmoothedMarble"]/statBases</xpath>
		<value>
			<statBases>
			      <Beauty>2</Beauty> <!-- normal 1, marble 2-->
				  <MarketValue>25</MarketValue> <!-- marble -->
			</statBases>
		</value>
	</Operation>

<!-- Rock Blocks Items statBases, influences built walls -->
	<Operation Class="PatchOperationReplace">
		<xpath>*/ThingDef[defName = "BlocksSandstone" or defName = "BlocksGranite" or defName = "BlocksLimestone" or defName = "BlocksSlate" or defName = "BlocksMarble"]/statBases</xpath>
		<value>
			<statBases>
				<Mass>1.25</Mass> <!-- granite -->
				<SharpDamageMultiplier>.65</SharpDamageMultiplier> <!-- granite -->
			</statBases>
		</value>
	</Operation>

<!-- Rock Blocks Items statFactors, influences built walls -->
	<Operation Class="PatchOperationReplace">
		<xpath>*/ThingDef[defName = "BlocksSandstone" or defName = "BlocksGranite" or defName = "BlocksLimestone" or defName = "BlocksSlate" or defName = "BlocksMarble"]/stuffProps/statFactors</xpath>
		<value>
			<statFactors>
				<Beauty>1.35</Beauty> <!-- marble -->
				<MaxHitPoints>1.7</MaxHitPoints> <!-- granite -->
				<WorkToBuild>6.0</WorkToBuild> <!-- granite/generic -->
				<WorkToMake>1.3</WorkToMake> <!-- granite/generic -->
			</statFactors>
		</value>
	</Operation>

<!-- Cut Not-Marble Blocks statOffsets, marble already has 1 beauty and others have BLANK beauty so u need to add-->
	<Operation Class="PatchOperationAdd">
		<xpath>*/ThingDef[defName = "BlocksSandstone" or defName = "BlocksGranite" or defName = "BlocksLimestone" or defName = "BlocksSlate"]/stuffProps</xpath>
		<value>
			<statOffsets>
				<Beauty>1</Beauty> <!-- marble --> 
			</statOffsets>
		</value>
	</Operation>
	
<!-- Stone Chunks -->
	<Operation Class="PatchOperationReplace">
		<xpath>*/ThingDef[defName = "ChunkSandstone" or defName = "ChunkGranite" or defName = "ChunkLimestone" or defName = "ChunkSlate" or defName = "ChunkMarble"]/statBases</xpath>
		<value>
			<statBases>
				<Mass>25</Mass> <!-- granite/marble, slate is 18, etc -->
			</statBases>
		</value>
	</Operation>

</Patch>