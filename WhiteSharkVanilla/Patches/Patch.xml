  <!-- Road Remove -->

  <Operation Class="PatchOperationRemove">
	<xpath>/Defs/WorldGenStepDef[defName = "AncientRoads"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
	<xpath>/Defs/WorldGenStepDef[defName = "Roads"]</xpath>
  </Operation>


	<!-- Never Retreat -->

  <Operation Class="PatchOperationReplace">
    <xpath>*/MentalStateDef[defName = "PanicFlee"]/stateClass</xpath>
    <value>
      <stateClass>NeverRetreat.MentalState_PanicFleeNoHostile</stateClass>
    </value>
  </Operation>

	<!-- Rain and Time -->
	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
		<operations>

			<!-- Filth Vanishes With Rain And Time -->
				
			<!-- Remove all entries for rainWashes then readd them to ensure they're all true -->
			
            <li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[filth]/filth/rainWashes</xpath>
            </li>

			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[filth]/filth</xpath>
				<value>
					<rainWashes>true</rainWashes>
				</value>
			</li>
				
			<!-- Only change entries with disappearsInDays 15 or above -->

			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef [number(substring-before(filth/disappearsInDays, '~')) >= 15] /filth/disappearsInDays</xpath>
				<value>
					<disappearsInDays>14~15</disappearsInDays>
				</value>
			</li>
			
		</operations>
	</Operation>



	<!-- No Carried Food -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThinkTreeDef[defName="Humanlike"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalColonist"]/subNodes/li[@Class="ThinkNode_ConditionalNeedPercentageAbove" and need[text()="Food"]]/threshold</xpath>
		<value>
			<threshold>1</threshold>
		</value>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
				<li>Android tiers</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThinkTreeDef[defName="AndroidLike"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalColonist"]/subNodes/li[@Class="ThinkNode_ConditionalNeedPercentageAbove" and need[text()="Food"]]/threshold</xpath>
			<value>
				<threshold>1</threshold>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
				<li>The Human Hive</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThinkTreeDef[defName="HiveQueenT"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalColonist"]/subNodes/li[@Class="ThinkNode_ConditionalNeedPercentageAbove" and need[text()="Food"]]/threshold</xpath>
			<value>
				<threshold>1</threshold>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
				<li>The Human Hive</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThinkTreeDef[defName="HiveThinkTree"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalColonist"]/subNodes/li[@Class="ThinkNode_ConditionalNeedPercentageAbove" and need[text()="Food"]]/threshold</xpath>
			<value>
				<threshold>1</threshold>
			</value>
		</match>
	</Operation>

  	<!-- Romance Mood -->

